parameters:
    level: 5
    paths:
        - src/
        - tests/
    excludePaths:
        - vendor/*
    ignoreErrors:
        # FirewallListenerOrder is not part of a released Symfony version yet
        -
            identifier: attribute.notFound
            path: src/Security/Http/Firewall/RefreshAccessTokenListener.php
            reportUnmatched: false
